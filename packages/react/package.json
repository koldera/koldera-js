{
  "name": "@koldera/react",
  "version": "0.1.0",
  "description": "React provider and hooks for koldera-core: PDF checks, HTML and structured documents to tagged PDF, web scans and reading-order review with short-lived sessions minted by your backend.",
  "license": "Apache-2.0",
  "author": "makulatura78",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koldera/koldera-js.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/koldera/koldera-js#readme",
  "bugs": {
    "url": "https://github.com/koldera/koldera-js/issues"
  },
  "keywords": ["accessibility", "pdf", "pdf-ua", "react", "hooks", "koldera"],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@koldera/sdk": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
