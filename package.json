{
  "name": "koldera-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:docs && pnpm test:scripts",
    "lint": "pnpm -r lint",
    "test:docs": "pnpm -r build && vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:live": "pnpm --filter @koldera/sdk build && vitest run tests/live-core.test.ts",
    "docs:api": "pnpm -r build && typedoc",
    "licences": "node scripts/check-licences.mjs",
    "hygiene": "node scripts/check-source-hygiene.mjs",
    "hygiene:test": "node --test scripts/check-source-hygiene.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
