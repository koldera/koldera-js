{
  "name": "pdf-job-unauthorized",
  "operationId": "createPdfJob",
  "auth": "server",
  "request": {
    "method": "POST",
    "path": "/v1/pdf/jobs",
    "headers": {
      "Authorization": "Bearer {{secretKey}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idempotencyKey}}"
    },
    "body": {
      "uploadId": "11111111-1111-4111-8111-111111111111",
      "mode": "fix",
      "profile": "ua1"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "body": {
      "type": "about:blank",
      "title": "Unauthorized",
      "status": 401,
      "code": "UNAUTHORIZED",
      "detail": "A valid bearer token is required."
    }
  }
}
