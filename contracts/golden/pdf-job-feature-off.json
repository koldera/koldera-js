{
  "name": "pdf-job-feature-off",
  "operationId": "createPdfJob",
  "auth": "server",
  "request": {
    "method": "POST",
    "path": "/v1/pdf/jobs",
    "headers": {
      "Authorization": "Bearer {{secretKey}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idempotencyKey}}"
    },
    "body": {
      "uploadId": "11111111-1111-4111-8111-111111111111",
      "mode": "fix",
      "profile": "ua1"
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "body": {
      "type": "about:blank",
      "title": "Not found",
      "status": 404,
      "code": "NOT_FOUND"
    }
  },
  "notes": "404 NOT_FOUND also means the feature is switched off on this instance."
}
