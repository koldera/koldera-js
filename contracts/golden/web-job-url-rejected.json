{
  "name": "web-job-url-rejected",
  "operationId": "createWebJob",
  "auth": "server",
  "request": {
    "method": "POST",
    "path": "/v1/web/jobs",
    "headers": {
      "Authorization": "Bearer {{secretKey}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idempotencyKey}}"
    },
    "body": {
      "url": "https://internal.invalid/"
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "body": {
      "type": "about:blank",
      "title": "Invalid job request",
      "status": 422,
      "code": "VALIDATION_ERROR",
      "detail": "url rejected: private destination"
    }
  }
}
